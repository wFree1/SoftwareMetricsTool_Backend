<?xml version="1.0" encoding="UTF-8"?>
<uml:Model xmlns:uml="http://www.omg.org/spec/UML/20131001" xmlns:xmi="http://www.omg.org/spec/XMI/20131001" xmi:id="_model-123">
  
  <!-- 类定义示例 -->
  <packagedElement xmi:type="uml:Class" xmi:id="class1" name="Person">
    <!-- 属性 -->
    <ownedAttribute xmi:id="attr1" name="name" type="String" visibility="private"/>
    <ownedAttribute xmi:id="attr2" name="age" type="Integer" visibility="private"/>
    
    <!-- 方法 - 符合OwnedOperation类定义 -->
    <ownedOperation id="op1" name="getName" visibility="public" precondition="name != null" postcondition="return != null" bodyCondition="no side effects">
      <!-- 操作规则 - 正确的Specification格式 -->
      <ownedRule id="rule1" name="nameValidation">
        <specification type="OCL" id="spec1" name="nameInitialized" value="name must be initialized"/>
      </ownedRule>
      
      <ownedParameter xmi:id="return1" direction="return" type="String"/>
    </ownedOperation>
    
    <ownedOperation id="op2" name="setName" visibility="public" precondition="parameter != null" postcondition="name == parameter" bodyCondition="updates name field">
      <ownedRule id="rule3" name="parameterValidation">
        <specification type="OCL" id="spec3" name="lengthCheck" value="parameter length must be > 0"/>
      </ownedRule>
      <ownedParameter xmi:id="param1" name="name" type="String"/>
    </ownedOperation>
    
    <ownedOperation id="op3" name="calculateBirthYear" visibility="protected" precondition="age >= 0" postcondition="return > 1900" bodyCondition="pure calculation">
      <ownedRule id="rule4" name="calculationRule">
        <specification type="OCL" id="spec4" name="ageCalculation" value="current year - age"/>
      </ownedRule>
      <ownedParameter xmi:id="return2" direction="return" type="Integer"/>
    </ownedOperation>
  </packagedElement>
  
  <!-- 接口定义示例 -->
  <packagedElement xmi:type="uml:Interface" xmi:id="interface1" name="Identifiable">
    <!-- 接口方法 -->
    <ownedOperation id="intOp1" name="getId" visibility="public" postcondition="return != null">
      <ownedRule id="rule5" name="idFormat">
        <specification type="OCL" id="spec5" name="formatCheck" value="ID must follow standard format"/>
      </ownedRule>
      <ownedParameter xmi:id="intReturn1" direction="return" type="String"/>
    </ownedOperation>
  </packagedElement>
  
  <!-- 另一个类示例 -->
  <packagedElement xmi:type="uml:Class" xmi:id="class2" name="Employee">
    <ownedAttribute xmi:id="attr3" name="employeeId" type="String" visibility="private"/>
    <ownedAttribute xmi:id="attr4" name="department" type="String" visibility="private"/>
    
    <ownedOperation id="empOp1" name="calculateSalary" visibility="public" precondition="employee is active" postcondition="return > 0" bodyCondition="includes all bonuses">
      <ownedRule id="rule7" name="salaryCalculation">
        <specification type="OCL" id="spec7" name="salaryFormula" value="base + bonus + allowances"/>
      </ownedRule>
      <ownedParameter xmi:id="empReturn1" direction="return" type="Double"/>
    </ownedOperation>
  </packagedElement>
  
  <!-- 类之间的关系 -->
  <packagedElement xmi:type="uml:Generalization" xmi:id="gen1" general="class2" specific="class1"/>
  <packagedElement xmi:type="uml:InterfaceRealization" xmi:id="real1" client="class1" supplier="interface1"/>
</uml:Model>