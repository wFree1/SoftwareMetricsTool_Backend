<?xml version="1.0" encoding="UTF-8"?>
<Model a="example_value" xmlns:o="http://www.example.com/namespace" xmlns:c="http://www.example.com/childrenNamespace" xmlns:a="http://www.example.com/attributesNamespace">
    <RootObject Id="rootObjectID">
        <c:Children>
            <o:Model Id="modelID">
                <c:Processes>
                    <o:Process>
                        <Name>HR Process</Name>
                        <Description>This process covers the hiring and onboarding of new employees.</Description>
                        <Attributes>
                            <Attribute name="step1" type="String">Screening</Attribute>
                            <Attribute name="step2" type="String">Interviewing</Attribute>
                            <Attribute name="step3" type="String">Onboarding</Attribute>
                        </Attributes>
                    </o:Process>
                    <o:Process>
                        <Name>IT Support Process</Name>
                        <Description>This process includes handling IT support tickets and resolving technical issues.</Description>
                        <Attributes>
                            <Attribute name="priorityLevels" type="Integer">3</Attribute>
                            <Attribute name="responseTime" type="String">24 hours</Attribute>
                        </Attributes>
                    </o:Process>
                </c:Processes>
                <c:Flows>
                    <o:Flow Id="flow1">
                        <a:Name>Data Flow 1</a:Name>
                        <Description>Flow of data from HR to Payroll system.</Description>
                        <c:Object1>
                            <Name>Employee Data</Name>
                            <Type>XML</Type>
                            <Size>5MB</Size>
                        </c:Object1>
                        <c:Object2>
                            <Name>Payroll System</Name>
                            <Type>Database</Type>
                            <Status>Active</Status>
                        </c:Object2>
                    </o:Flow>
                    <o:Flow Id="flow2">
                        <a:Name>Data Flow 2</a:Name>
                        <Description>Flow of support tickets from Helpdesk system to IT Support team.</Description>
                        <c:Object1>
                            <Name>Support Tickets</Name>
                            <Type>JSON</Type>
                            <Size>10MB</Size>
                        </c:Object1>
                        <c:Object2>
                            <Name>IT Support System</Name>
                            <Type>Application</Type>
                            <Status>Active</Status>
                        </c:Object2>
                    </o:Flow>
                </c:Flows>
                <c:OrganizationUnits>
                    <o:OrganizationUnit>
                        <Name>Human Resources</Name>
                        <Description>Responsible for managing employee relations and HR activities.</Description>
                    </o:OrganizationUnit>
                    <o:OrganizationUnit>
                        <Name>IT Department</Name>
                        <Description>Handles all IT-related tasks, including support and infrastructure management.</Description>
                    </o:OrganizationUnit>
                </c:OrganizationUnits>
                <c:Resources>
                    <o:Resource>
                        <Name>Employee Database</Name>
                        <Description>Contains all employee records and personal information.</Description>
                    </o:Resource>
                    <o:Resource>
                        <Name>IT Support Ticket System</Name>
                        <Description>System used to manage and track IT support tickets.</Description>
                    </o:Resource>
                </c:Resources>
            </o:Model>
        </c:Children>
    </RootObject>
</Model>